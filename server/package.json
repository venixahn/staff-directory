{
  "name": "@staff/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:coverage:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:coverage:integration": "vitest run --config vitest.api.config.ts --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@staff/shared": "*",
    "effect": "^3.18.4",
    "lowdb": "^7.0.1",
    "pdfmake": "^0.2.20",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/pdfmake": "^0.2.11",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-istanbul": "^3.2.7",
    "c8": "^12.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
